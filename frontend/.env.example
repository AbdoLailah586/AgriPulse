# AgriPulse Frontend Environment Configuration

# Backend API Base URL (point to your FastAPI, Flask, Node.js, or Django backend)
# Example: http://localhost:8000/api or https://api.agripulse.farm/api
VITE_API_BASE_URL=http://localhost:8000/api

# Standalone Mock Mode Toggle
# - 'true': Frontend operates 100% independently using calibrated realistic mock data (zero backend required)
# - 'false': Frontend connects to the real backend at VITE_API_BASE_URL
VITE_USE_MOCK_DATA=true

# Application Environment ('development' | 'staging' | 'production')
VITE_ENV=development
